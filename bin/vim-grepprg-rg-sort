# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

# YOU: Set max columns nonzero to omit long lines, which can make (in this
#      author's opinion) it more tedious to scan the quickfix results).
#  DUBS_VIM_RG_MAX_COLS=0
DUBS_VIM_RG_MAX_COLS=200

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

# `rg` options used below
# =======================
#
# For a discussion of the `rg` the options below, see:
#
#   dubs_grep_steady/plugins/dubs_grep_steady.vim::SetGrepprgRg

# `sort` options used below
# =========================
#
# For a discussion of the `sort` options, let me explain!
#
# - The RipGrep results are of the form: /path/to/file:linenumber:matching text
#
#   E.g.,
#
#     vim-grepprg-rg-sort:10:	# - The RipGrep results are of the form: ...
#
# - Tell `sort` to sort alphabetically by filename, then numerically by line.
#
#   Options we use, annotated by `man sort`:
#
#    -t     --field-separator=SEP
#
#            "use SEP instead of non-blank to blank transition." Useful
#            when sorting by fields, e.g., `-t:` to split on colon.
#
#    -k      --key=KEYDEF
#
#            "KEYDEF is F[.C][OPTS][,F[.C][OPTS]] for start and stop
#             position, where F is a field number and C a character
#             position in the field; both are origin 1, and the stop
#             position defaults to the line's end.
#
#            "OPTS is one or more single-letter ordering options
#             [bdfgiMhnRrV], which override global ordering options for
#             that key. If no key is given, use the entire line as the
#             key."
#
#             - SAVVY: Use `-k1,1` to sort first by first field (filename),
#               and not just `-k1`, or `sort` walks to the end of the string.
#
#             - And then use `-k2,2n` to sort on the second field, when
#               necessary. The `n` picks `--numeric-sort`.
#
#   --debug  "Use --debug to diagnose incorrect key usage."
#
#             - USAGE: For our use case, it'd be:
#
#               rg ... | sort --debug -t: -k1,1 -k2,2n
#
# Why we sort
# ===========
#
# Note that we sort results — which precludes loading results asychronously
# — so that quickfix results are *repeatable*.
#
# - Use case: Suppose you need to audit every use of some term. So you search
#   the term and start going through the quickfix results. Let's suppose you
#   get halfway through but then need to search something else. After you
#   finish the distraction, you can search the first term again and you know
#   you can resume auditing where you left off, because the quickfix results
#   are in the same order. (I'm sure there's a way to save quickfix results
#   so you can return to the same results again in the future, but this
#   approach works without needing to cache quickfix lists.)

# Quickfix shows *full* paths
# ===========================
#
# SAVVY: Quickfix shows full paths, regardless of how we print them.
# - E.g., if we use a tilde prefix, such as this:
#     rg ... | sed -E "s#^${HOME}(/|$)#~\1#"
#   You'll still see full paths in the quickfix buffer.

# Format results to match |grepformat|
# ====================================
#
# REFER: We craft our own `rg` command & options below, but there's
# a similar built-in option, `rg --vimgrep`, which is the same as:
#   rg -A 0 -B 0 --line-number --column --no-heading --with-filename
# - Though from `man rg`: "With this option, a line with more than one
#   match will be printed in its entirety more than once. For that reason,
#   the total amount of output as a result of this flag can be quadratic
#   in the size of the input." And: "One alternative to avoiding exorbitant
#   memory usage is to force ripgrep into single threaded mode with the
#   -j/--threads flag. Note though that this will not impact the total
#   size of the output, just the heap memory that ripgrep will use."
#   - Which makes it sound scary.
#   - Also, why would you want more than one line per matching line?
#     - Do some Vim users want separate quickfix results for each
#       column match for the same line?? I guess maybe, because
#       that's the default in Neovim.
#     - By default, Neovim quickfix does not recognize the `rg`
#       output unless we include --column numbers (and Neovim's
#       default grepprg is `rg --vimgrep -uu`).
#     - But author finds column numbers distracting, and useless
#       at best, e.g., compare thie output with column numbers:
#         /path/to/some/file.foo|121 col 20| bar baz bat quuz
#         /path/to/some/file.foo|144 col 13|   wizzle wuzzle
#       against the output without column numbers:
#         /path/to/some/file.foo|121| bar baz bat quuz
#         /path/to/some/file.foo|144|   wizzle wuzzle
#       and I'd say the latter results are quicker to read, and
#       that the column numbers don't add much value (at least
#       not for the author's workflow).
# - Considering all that, whether or not to include the column is
#   a matter of taste and also related to the domain in which you're
#   working (perhaps it helps to see a quickfix line for every result).
#   - In Vim, the opinion of its publisher was to exclude columns.
#   - But in Neovim, the maintainers decided the opposite was desirable
#     by default.
#   - We'll not be opinionated herein but work with either format —
#     we just need the Vim script to set an environ to tell us which
#     format to use.
#     - See: GREPSTEADY_INCLUDE_COLUMNS
#
# REFER: Default |grepformat| values:
# - Vim:
#     " Vim --noplugin: `echo &grepformat`:
#     set grepformat=%f:%l:%m,%f:%l%m,%f\ \ %l%m
# - Neovim:
#     " Neovim --noplugin: `echo &grepformat`:
#     %f:%l:%c:%m

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

check_deps () {
  must_verify_rip_grep
}

must_verify_rip_grep () {
  if rip_grep_executable > /dev/null; then

    return 0
  fi

  >&2 echo "ERROR: Cound not find dependency: RipGrep"
  >&2 echo "- HINT: Try, e.g., \`apt install rg\`"

  exit 1
}

# Resolve path to `rg`, so that we don't inadvertently call user's `rg`
# alias (e.g., user aliases `rg` to `tag`, for interactive CLI results).
# - CALSO: Using `command rg` would similarly achieve the same result.
rip_grep_executable () {
  type -P rg
}

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

# [lb] 2019-01-06: BEWARE: I don't remember a findup feature, but there's one!
#   --no-ignore-parent  # Walks up tree honoring .ignore files.
# The only issue is that when files are ignored, and you want to track down the
# .ignore file responsible, you need to remember to walk up from all search paths.
# SAVVY: Testing shows `rg` skip graphics formats: *.jpg, *.png, *.xcf
# - DUNNO/2024-11-25: Recent usage actually suggests otherwise; so --glob'd below.
# USYNC: Similar rg --glob's (found locally at these paths within DepoXy environ):
#   ~/.depoxy/ambers/core/fzf-setup.sh
#   ~/.kit/sh/home-fries/lib/alias/alias_rg_tag.sh
#   ~/.kit/nvim/landonb/start/dubs_grep_steady/bin/vim-grepprg-rg-sort
#   ~/.kit/nvim/landonb/opt/dubs_file_finder/plugin/dubs_file_finder.vim
rip_grep_sleep_repeat () {
  local column_arg=""
  if [ "${GREPSTEADY_INCLUDE_COLUMNS:-false}" = "true" ]; then
    column_arg="--column"
  fi

  local dglobs=()
  local fglobs=()
  # Common dev tool directories
  dglobs+=(".git")
  dglobs+=(".tox")
  dglobs+=("node_modules")
  # Home directories
  # Vim's ~/.vim_backups/*.swp
  fglobs+=("*.swp")
  # Graphics, Document, and other files (you probably won't open in text)
  fglobs+=(".bash_history")
  fglobs+=("*.bin")
  fglobs+=("*.gif")
  fglobs+=("*.gpg")
  fglobs+=("*.jpg")
  fglobs+=("*.Jpg")
  fglobs+=("*.JPG")
  fglobs+=("*.nib")
  fglobs+=("*.odg")
  fglobs+=("*.odt")
  # SAVVY: `rg --ignore-case` doesn't seem to work on globs, so add permutations
  fglobs+=("*.pdf")
  fglobs+=("*.Pdf")
  fglobs+=("*.PDF")
  fglobs+=("*.png")
  fglobs+=("*.pyc")
  fglobs+=("*.svg")
  fglobs+=(".viminfo")
  fglobs+=("*.xpm")
  fglobs+=("*.zip")
  # Vim :Helptags tags files
  fglobs+=("doc/tags")

  local dir_globs=""
  local dglob
  for dglob in "${dglobs[@]}"; do
    [ -z "${dir_globs}" ] || dir_globs="${dir_globs},"
    dir_globs="${dir_globs}${dglob}"
  done

  local file_globs=""
  local fglob
  for fglob in "${fglobs[@]}"; do
    [ -z "${file_globs}" ] || file_globs="${file_globs},"
    file_globs="${file_globs}${fglob}"
  done

  $(rip_grep_executable) \
    -A 0 \
    -B 0 \
    --hidden \
    --follow \
    --no-ignore-vcs \
    --line-number \
    ${column_arg} \
    --no-heading \
    --with-filename \
    --max-columns ${DUBS_VIM_RG_MAX_COLS} \
    --glob "!**/{${dir_globs}}/**" \
    --glob "!**/{${file_globs}}" \
    "$@" \
    | sort -t: -k1,1 -k2,2n
}

main () {
  check_deps

  rip_grep_sleep_repeat "$@"
}

main "$@"

